{
  "name": "poketoken-desktop",
  "version": "0.5.2",
  "private": true,
  "description": "AI coding tokens, a little desktop companion.",
  "main": "out/main/index.js",
  "author": "PokeToken Desktop contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build-native.mjs && electron-vite build",
    "predev": "node scripts/build-native.mjs",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:portable": "node scripts/portable-smoke.mjs",
    "smoke:dev": "node scripts/dev-smoke.mjs",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg --x64 --publish never",
    "smoke:pet": "node scripts/pet-smoke.mjs",
    "smoke:windows": "node scripts/windows-smoke.mjs",
    "smoke:dpi": "node scripts/dpi-smoke.mjs",
    "smoke:health": "node scripts/health-smoke.mjs",
    "smoke:collection": "node scripts/collection-smoke.mjs",
    "smoke:dashboard": "node scripts/dashboard-smoke.mjs",
    "smoke:input": "node scripts/input-smoke.mjs",
    "smoke:session": "node scripts/session-smoke.mjs",
    "smoke:evolution": "node scripts/evolution-smoke.mjs",
    "smoke:rewards": "node scripts/rewards-smoke.mjs",
    "smoke:i18n": "node scripts/i18n-smoke.mjs",
    "smoke:catalog": "node scripts/catalog-smoke.mjs",
    "smoke:rarity": "node scripts/rarity-smoke.mjs",
    "smoke:delivery": "node scripts/delivery-smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
